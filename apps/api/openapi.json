{
  "openapi": "3.1.0",
  "info": {
    "title": "Rusticate Product API",
    "description": "Multi-tenant product API. Every error is RFC 9457 `application/problem+json`.",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/billing/settings": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "The tenant's billing settings.",
        "operationId": "getBillingSettings",
        "responses": {
          "200": {
            "description": "Current settings.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSettingsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.settings.read`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Billing is not configured.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "billing"
        ],
        "summary": "Create (`If-None-Match: *`) or update (`If-Match`) the tenant's billing settings.",
        "operationId": "configureBilling",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "description": "Current ETag, to update existing settings.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "`*`, to create settings.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureBillingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Settings updated.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSettingsResponse"
                }
              }
            }
          },
          "201": {
            "description": "Settings created.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSettingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.settings.manage`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "Stale ETag, or settings already exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "No conditional header sent.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/billing/stats": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "Invoice statistics (eventually consistent, typically within seconds).",
        "operationId": "getBillingStats",
        "responses": {
          "200": {
            "description": "Statistics per currency.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingStatsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.invoice.read`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/invoices": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "List invoices.",
        "operationId": "listInvoices",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1..=100 (default 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from the previous page's `next_cursor`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only invoices in this status: `issued`, `paid` or `void`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of invoices.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.invoice.read`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Issue an invoice.",
        "description": "Idempotent: retrying with the same `Idempotency-Key` and body returns the\noriginal invoice; a different body with the same key is rejected.",
        "operationId": "issueInvoice",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated key (e.g. a UUID), unique per intended invoice.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueInvoiceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Invoice issued (or replayed).",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or missing Idempotency-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.invoice.issue`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A request with this key is in flight.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Billing not configured, a business rule failed, or the key was reused with another body.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/invoices/{invoice_id}": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "One invoice.",
        "operationId": "getInvoice",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "description": "Invoice id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The invoice.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.invoice.read`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such invoice for this tenant.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/invoices/{invoice_id}/void": {
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Void an issued invoice.",
        "operationId": "voidInvoice",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "description": "Invoice id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "The invoice's current ETag.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidInvoiceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The voided invoice.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Missing `billing.invoice.void`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such invoice for this tenant.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The invoice cannot be voided in its current state.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "Stale ETag.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "If-Match missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BillingSettingsResponse": {
        "type": "object",
        "description": "Tenant billing settings.",
        "required": [
          "currency",
          "tax_rate_bps",
          "version"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency of every invoice issued by this tenant.",
            "example": "IDR"
          },
          "tax_rate_bps": {
            "type": "integer",
            "format": "int32",
            "description": "Tax rate in basis points (1100 = 11 %).",
            "example": 1100,
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Also sent as the `ETag` header; send it back in `If-Match` to update."
          }
        }
      },
      "BillingStatsResponse": {
        "type": "object",
        "description": "Invoice statistics, per currency.",
        "required": [
          "currencies"
        ],
        "properties": {
          "currencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyStatsResponse"
            }
          }
        }
      },
      "ConfigureBillingRequest": {
        "type": "object",
        "description": "Billing settings to create or replace.",
        "required": [
          "currency",
          "tax_rate_bps"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217 code: IDR, JPY, SGD or USD.",
            "example": "IDR"
          },
          "tax_rate_bps": {
            "type": "integer",
            "format": "int32",
            "description": "Tax rate in basis points, 0..=10000 (1100 = 11 %).",
            "example": 1100,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "CurrencyStatsResponse": {
        "type": "object",
        "required": [
          "currency",
          "issued_count",
          "issued_total_minor",
          "voided_count",
          "voided_total_minor"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "example": "IDR"
          },
          "issued_count": {
            "type": "integer",
            "format": "int64"
          },
          "issued_total_minor": {
            "type": "integer",
            "format": "int64"
          },
          "voided_count": {
            "type": "integer",
            "format": "int64"
          },
          "voided_total_minor": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "One invalid input field.",
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "JSON path of the offending field, e.g. `lines[2].quantity`."
          },
          "reason": {
            "type": "string",
            "description": "Why the value was rejected."
          }
        }
      },
      "InvoiceLineResponse": {
        "type": "object",
        "description": "One invoice line.",
        "required": [
          "description",
          "quantity",
          "unit_price_minor",
          "line_total_minor"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "line_total_minor": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "unit_price_minor": {
            "type": "integer",
            "format": "int64",
            "description": "Unit price in minor units of the invoice currency."
          }
        }
      },
      "InvoicePageResponse": {
        "type": "object",
        "description": "One page of invoices, newest first.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceSummaryResponse"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` for the next page. Absent on the last page."
          }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "description": "A complete invoice. Amounts are integers in minor units of `currency`.",
        "required": [
          "id",
          "status",
          "customer_email",
          "currency",
          "lines",
          "subtotal_minor",
          "tax_rate_bps",
          "tax_minor",
          "total_minor",
          "version",
          "issued_at"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "example": "IDR"
          },
          "customer_email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLineResponse"
            }
          },
          "status": {
            "type": "string",
            "example": "issued"
          },
          "subtotal_minor": {
            "type": "integer",
            "format": "int64"
          },
          "tax_minor": {
            "type": "integer",
            "format": "int64"
          },
          "tax_rate_bps": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total_minor": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Also sent as the `ETag` header."
          },
          "void_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "voided_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "InvoiceSummaryResponse": {
        "type": "object",
        "description": "An invoice in a list.",
        "required": [
          "id",
          "status",
          "customer_email",
          "currency",
          "total_minor",
          "version",
          "issued_at"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "total_minor": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IssueInvoiceLine": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price_minor"
        ],
        "properties": {
          "description": {
            "type": "string",
            "example": "Consulting, March"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "1 to 1,000,000.",
            "example": 2,
            "minimum": 0
          },
          "unit_price_minor": {
            "type": "integer",
            "format": "int64",
            "description": "Unit price in minor units of the tenant currency (e.g. sen for IDR).",
            "example": 15000000
          }
        },
        "additionalProperties": false
      },
      "IssueInvoiceRequest": {
        "type": "object",
        "description": "An invoice to issue. Currency and tax rate come from the tenant's settings.",
        "required": [
          "customer_email",
          "lines"
        ],
        "properties": {
          "customer_email": {
            "type": "string",
            "example": "finance@customer.example"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueInvoiceLine"
            },
            "description": "1 to 200 lines."
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details, extended with stable machine-readable members.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "error_code"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Explanation specific to this occurrence. Never contains internal details."
          },
          "error_code": {
            "type": "string",
            "description": "Stable machine-readable code. Clients branch on this, never on `detail`.",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "description": "Field-level violations, for validation failures."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "URI reference of this occurrence: the request path.",
            "example": "/v1/invoices"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request id (also echoed in the `x-request-id` response header)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "example": 400,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type (the HTTP reason phrase).",
            "example": "Bad Request"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C trace id of the request, for support correlation."
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type: `/problems/{error-code}`.",
            "example": "/problems/validation-failed"
          }
        }
      },
      "VoidInvoiceRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the invoice is voided (kept for audit).",
            "example": "Issued to the wrong customer"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "billing",
      "description": "Tenant billing settings and invoices."
    }
  ]
}
