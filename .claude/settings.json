{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/architecture.toml)",
      "Edit(/clippy.toml)",
      "Edit(/crates/domains/*-engine/clippy.toml)",
      "Edit(/deny.toml)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/.squawk.toml)",
      "Edit(/.github/**)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/post-edit.sh",
            "args": [],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/stop-gate.sh",
            "args": [],
            "timeout": 900
          }
        ]
      }
    ]
  }
}
