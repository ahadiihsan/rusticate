/// HOP 2: authorize → tenant tx → idempotency → load → engine → persist →
/// outbox → complete → commit.
#[tracing::instrument(
    name = "{{domain}}.{{feature}}",
    skip_all,
    fields(tenant_id = %ctx.tenant_id(), actor_id = %ctx.actor_id())
)]
pub async fn {{feature}}(
    ctx: &OpCtx,
    db: &DataStore,
    key: &IdempotencyKey,
    cmd: {{Feature}}Cmd,
) -> Result<{{Feature}}Result, {{Domain}}Error> {
    ctx.require(permissions::{{PERMISSION}})?;
    let fingerprint = Fingerprint::of(OPERATION, &cmd)?;

    let mut tx = db.begin(ctx).await?;
    let pending = match idempotency::claim(&mut tx, OPERATION, key, &fingerprint).await? {
        Claim::Replay(previous) => return Ok(previous),
        Claim::Fresh(pending) => pending,
    };

    // SCAFFOLD: load state (db::*), decide with {{domain_ident}}_engine, persist, tx.emit(..).
    db::current_tenant(&mut tx).await?;
    let result = {{Feature}}Result {
        reference: cmd.reference,
    };

    pending.complete(&mut tx, &result).await?;
    tx.commit().await?;
    Ok(result)
}
