-- Fail fast instead of queueing behind live traffic (DB-011).
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '5min';

CREATE TABLE {{schema}}.example (
    tenant_id   uuid        NOT NULL DEFAULT platform.current_tenant_id(),
    id          uuid        NOT NULL,
    version     integer     NOT NULL DEFAULT 1,
    created_at  timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT example_pkey PRIMARY KEY (tenant_id, id)
);

ALTER TABLE {{schema}}.example ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{schema}}.example FORCE ROW LEVEL SECURITY;
CREATE POLICY tenant_isolation ON {{schema}}.example
    USING (tenant_id = (SELECT platform.current_tenant_id()))
    WITH CHECK (tenant_id = (SELECT platform.current_tenant_id()));
GRANT SELECT, INSERT, UPDATE ON {{schema}}.example TO app_rw;
